{
  "name": "@adhiksit/dayflow",
  "version": "1.0.0",
  "description": "A lightweight, offline-first productivity engine and CLI that tracks tasks, timers, calculates explainable productivity scores, and generates daily and weekly summaries.",
  "author": "Adhiksit Chobber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adhiksit/dayflow.git"
  },
  "homepage": "https://github.com/adhiksit/dayflow#readme",
  "bugs": {
    "url": "https://github.com/adhiksit/dayflow/issues"
  },
  "keywords": [
    "productivity",
    "time-tracking",
    "task-manager",
    "cli",
    "pomodoro",
    "habits",
    "metrics",
    "offline-first",
    "scoring",
    "analytics"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dayflow": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
